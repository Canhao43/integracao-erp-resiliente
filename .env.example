APP_NAME="Integração ERP Resiliente"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Aponta para o MySQL do compose.yaml. Fica aqui, e não em "environment:" no
# compose, porque variável do container venceria o phpunit.xml e os testes
# rodariam no banco de desenvolvimento — apagando os dados (RefreshDatabase).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=erp_resiliente
DB_USERNAME=app
DB_PASSWORD=app

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ERP: o "outro lado" da integração. No Docker, o simulador responde pelo nginx.
ERP_URL=http://web/erp-simulado
ERP_TIMEOUT=3
# Espera, em segundos, antes de cada nova tentativa. Curto aqui para a demonstração.
ERP_BACKOFF=1,2,4,8,16

# O simulador falha de propósito (probabilidades de 0 a 1), inclusive depois de gravar.
ERP_SIMULADO_ATIVO=true
ERP_SIMULADO_FALHA=0.15
ERP_SIMULADO_FALHA_DEPOIS_DE_GRAVAR=0.1
ERP_SIMULADO_LATENCIA_MAXIMA_MS=300
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
